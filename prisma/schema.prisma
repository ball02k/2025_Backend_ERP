// AuditLog moved to line 2720 (more comprehensive version with tenantId)

model CVRSnapshot {
  id        Int      @id @default(autoincrement())
  tenantId  String
  projectId Int
  project   Project  @relation("ProjectCVRSnapshots", fields: [projectId], references: [id], onDelete: Cascade)
  period    String // "YYYY-MM"
  status    String   @default("DRAFT") // DRAFT, FINAL, SUPERSEDED
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Task 4.3: Snapshot identification
  snapshotNumber Int // Sequential per project
  snapshotRef    String // e.g., "CVR-2024-11"
  periodStart    DateTime
  periodEnd      DateTime

  // Task 4.2 & 4.3: Enhanced financial tracking
  snapshotDate DateTime @default(now()) // Date of the snapshot
  snapshotType String   @default("MONTHLY") // MONTHLY, QUARTER_END, YEAR_END, AD_HOC

  // Task 4.3: Project context at time of snapshot
  projectRole   String? // PRINCIPAL_CONTRACTOR, SUBCONTRACTOR
  contractValue Decimal? @db.Decimal(18, 2)
  valueSource   String? // APPLICATIONS or CERTIFICATES
  periodValue   Decimal? @db.Decimal(18, 2) // Value earned this period

  // Budget tracking
  originalBudget Decimal? @db.Decimal(18, 2) // Original approved budget
  currentBudget  Decimal? @db.Decimal(18, 2) // Budget including approved variations

  // Cost tracking (aggregated from all sources)
  committedCost Decimal? @db.Decimal(18, 2) // From contracts, POs, variations
  accruedCost   Decimal? @db.Decimal(18, 2) // Accrued but not yet invoiced
  invoicedCost  Decimal? @db.Decimal(18, 2) // Invoiced costs
  paidCost      Decimal? @db.Decimal(18, 2) // Actually paid costs
  totalCost     Decimal? @db.Decimal(18, 2) // Total of all costs

  // Cost breakdown by category
  labourCost        Decimal? @db.Decimal(18, 2)
  materialsCost     Decimal? @db.Decimal(18, 2)
  subcontractorCost Decimal? @db.Decimal(18, 2)
  plantCost         Decimal? @db.Decimal(18, 2)
  preliminariesCost Decimal? @db.Decimal(18, 2)
  overheadCost      Decimal? @db.Decimal(18, 2)
  otherCost         Decimal? @db.Decimal(18, 2)

  // Value tracking (from Task 4.1 - role-aware)
  certifiedValue Decimal? @db.Decimal(18, 2) // Value certified by client/MC
  appliedValue   Decimal? @db.Decimal(18, 2) // Value applied for
  pendingValue   Decimal? @db.Decimal(18, 2) // Applications not yet certified
  paidValue      Decimal? @db.Decimal(18, 2) // Value paid by client/MC
  totalValue     Decimal? @db.Decimal(18, 2) // Total value recognized

  // Retention tracking
  retentionHeld     Decimal? @db.Decimal(18, 2) // Retention held against us
  retentionReleased Decimal? @db.Decimal(18, 2) // Retention released to date

  // Calculated metrics
  grossMargin           Decimal? @db.Decimal(18, 2) // totalValue - totalCost
  grossMarginPercentage Decimal? @db.Decimal(9, 4) // (grossMargin / totalValue) * 100
  netMargin             Decimal? @db.Decimal(18, 2) // After overheads
  netMarginPercentage   Decimal? @db.Decimal(9, 4)

  // Variance tracking
  budgetVariance           Decimal? @db.Decimal(18, 2) // currentBudget - totalCost
  budgetVariancePercentage Decimal? @db.Decimal(9, 4) // (variance / currentBudget) * 100

  // Forecast to complete
  forecastFinalCost      Decimal? @db.Decimal(18, 2) // Anticipated final cost
  costToComplete         Decimal? @db.Decimal(18, 2) // Remaining cost to finish
  forecastFinalMargin    Decimal? @db.Decimal(18, 2)
  forecastMarginVariance Decimal? @db.Decimal(18, 2) // vs current margin

  // Source counts (for data quality tracking)
  poCount          Int? // Number of POs included
  invoiceCount     Int? // Number of invoices included
  directCostCount  Int? // Number of direct cost entries
  contractCount    Int? // Number of contracts included
  applicationCount Int? // Number of payment applications
  certificateCount Int? // Number of certificates

  // Enhanced notes
  keyIssues   String? @db.Text // Issues affecting CVR
  mitigations String? @db.Text // Actions being taken
  assumptions String? @db.Text // Assumptions in forecast

  // Task 4.3: Finalization workflow
  createdBy   Int? // User who created snapshot
  finalizedAt DateTime? // When snapshot was finalized
  finalizedBy Int? // User who finalized snapshot

  lines CVRSnapshotLine[]

  @@unique([tenantId, projectId, snapshotNumber])
  @@unique([tenantId, projectId, snapshotRef])
  @@index([tenantId, projectId, period])
  @@index([tenantId, projectId, periodEnd])
  @@index([tenantId, status])
  @@index([snapshotDate])
  @@index([snapshotType])
}

model CVRSnapshotLine {
  id           Int     @id @default(autoincrement())
  tenantId     String
  snapshotId   Int
  projectId    Int
  budgetLineId Int?
  packageId    Int?
  contractId   Int?
  code         String?
  name         String?

  planned      Decimal @default(0) @db.Decimal(18, 2) // from BudgetLine.planned at seed
  estimate     Decimal @default(0) @db.Decimal(18, 2) // from Contract value (sum per package)
  actualToDate Decimal @default(0) @db.Decimal(18, 2) // sum of invoices up to period end

  progressPct Decimal @default(0) @db.Decimal(5, 2) // editable % complete this period (0-100)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshot CVRSnapshot @relation(fields: [snapshotId], references: [id])

  @@index([tenantId, snapshotId])
  @@index([tenantId, projectId])
  @@index([tenantId, packageId])
  @@index([tenantId, budgetLineId])
  @@index([tenantId, contractId])
