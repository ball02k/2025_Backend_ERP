  tenantId    String   @default("demo")
  projectId   Int
  period      String
  periodMonth String?
  description String?
  amount      Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@unique([tenantId, projectId, period])
  @@index([tenantId, projectId])
  @@index([tenantId, projectId, periodMonth])
}

model FinancialItem {
  id        Int      @id @default(autoincrement())
  tenantId  String
  projectId Int
  name      String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId])
}

// Invoices (project-scoped)
model Invoice {
  id        Int    @id @default(autoincrement())
  tenantId  String
  projectId Int

  // Task 2.5: Invoice Direction
  direction String @default("INBOUND") // OUTBOUND (invoices we raise to MC/client), INBOUND (invoices we receive from subs)

  project            Project     @relation(fields: [projectId], references: [id])
  supplierId         Int?
  supplier           Supplier?   @relation(fields: [supplierId], references: [id])
  budgetLineId       Int? // CVR: Link to budget line
  budgetLine         BudgetLine? @relation(fields: [budgetLineId], references: [id])
  number             String
  supplierInvoiceRef String? // Supplier's own reference
  issueDate          DateTime?
  dueDate            DateTime?
  net                Decimal     @default(0)
  vat                Decimal     @default(0)
  gross              Decimal     @default(0)
  status             String      @default("RECEIVED") // "RECEIVED" | "DRAFT" | "PENDING_REVIEW" | "PENDING_MATCH" | "MATCHED" | "APPROVED" | "PAID" | "DISPUTED" | "CANCELLED"
  // Additive finance fields
  documentId         BigInt?
  documentUrl        String? // URL to uploaded invoice document
  documentName       String? // Original filename
  ocrStatus          String? // PENDING, COMPLETED, FAILED
  ocrResultJson      Json?
  ocrRawText         String?     @db.Text // Raw OCR text
  ocrConfidence      Float? // 0-1 confidence score
  poNumberRef        String?
  matchStatus        String? // UNMATCHED, PARTIAL_MATCH, FULL_MATCH, NO_PO_REQUIRED
  matchConfidence    Float? // 0-1 confidence score
  matchedPoId        Int?
  matchedBy          String? // User who confirmed the match
  source             String? // MANUAL, PDF_OCR, CSV_IMPORT, EMAIL
  // Additive links to tie into budget/contract rollups
  packageId          Int?
  contractId         Int?
  contract           Contract?   @relation(fields: [contractId], references: [id])
  // CVR: Enhanced workflow tracking
  receivedDate       DateTime?
  matchedDate        DateTime?
  approvedDate       DateTime?
  approvedBy         Int?
  paidDate           DateTime?
  paidAmount         Decimal?    @db.Decimal(18, 2)
  paymentRef         String? // Bank transfer reference
  disputeReason      String?     @db.Text
  createdBy          String? // User who created/uploaded the invoice
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Certificate matching for subcontractor invoices (Phase B)
  paymentApplicationId Int?
  paymentApplication   ApplicationForPayment? @relation(fields: [paymentApplicationId], references: [id])

  // Match metadata
  matchType          String? // "PO" | "CERTIFICATE" | "NONE"
  matchConfidenceNew Decimal?  @db.Decimal(5, 2) // 0-100 percentage (renamed to avoid conflict with matchConfidence Float)
  matchedAt          DateTime?
  matchedByUser      String? // User who confirmed the match (renamed to avoid confusion)
  matchNotes         String?   @db.Text

  // For invoices that don't need matching
  noMatchRequired Boolean @default(false)
  noMatchReason   String? // "Utility bill", "Professional fees", etc.

  @@index([tenantId, projectId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, projectId])
  @@index([tenantId, packageId])
  @@index([tenantId, contractId])
  @@index([tenantId, projectId, dueDate])
  @@index([tenantId, projectId, source])
  @@index([tenantId, budgetLineId])
  @@index([tenantId, projectId, direction])
}

/// Finance: Invoice line items (additive)
model InvoiceLine {
  id              Int         @id @default(autoincrement())
  tenantId        String      @default("demo")
  invoiceId       Int
  lineNo          Int
  description     String
  costCode        String?
  qty             Decimal     @default(0)
  unit            String?
  rate            Decimal     @default(0)
  vatRatePct      Float?
  totalExVat      Decimal     @default(0)
  totalVat        Decimal     @default(0)
  totalIncVat     Decimal     @default(0)
  // PO matching
  poLineItemId    Int? // Matched PO line item
  matchConfidence Float? // 0-1 confidence score for the match
  // Budget coding
  budgetLineId    Int?
  budgetLine      BudgetLine? @relation(fields: [budgetLineId], references: [id])

  @@index([tenantId, invoiceId])
  @@index([tenantId, poLineItemId])
  @@index([tenantId, budgetLineId])
}

/// Finance: Matching records (additive)
model FinanceMatch {
  id            Int      @id @default(autoincrement())
  tenantId      String   @default("demo")
  type          String // po_invoice|po_receipt|invoice_receipt|three_way
  status        String // proposed|accepted|rejected
  reason        String?
  varianceExVat Decimal? @default(0)
  varianceVat   Decimal? @default(0)
  varianceTotal Decimal? @default(0)
  toleranceUsed Decimal? @default(0)
  poId          Int?
  invoiceId     Int?
  receiptId     Int?
  createdAt     DateTime @default(now())
  createdById   Int?

  @@index([tenantId, type, status])
  @@index([tenantId, poId])
  @@index([tenantId, invoiceId])
}

/// Finance: Inbound email storage (additive)
model InboundEmail {
  id         Int      @id @default(autoincrement())
  tenantId   String   @default("demo")
  inbox      String
  fromAddr   String
  subject    String?
  bodyText   String?
  rawId      String?
  receivedAt DateTime @default(now())
  invoiceId  Int?
  status     String   @default("stored")
  error      String?

  attachments EmailAttachment[]

  @@index([tenantId, inbox, receivedAt])
}

model EmailAttachment {
  id             Int          @id @default(autoincrement())
  inboundEmailId Int
  inboundEmail   InboundEmail @relation(fields: [inboundEmailId], references: [id])
  filename       String
  mimeType       String?
  size           Int?
  documentId     BigInt?
}

// ==============================================================================
// ENHANCED Applications for Payment (AfP) - UK Construction Act Compliant
// ==============================================================================
model ApplicationForPayment {
  id       Int    @id @default(autoincrement())
  tenantId String

  // Relationships
  projectId  Int
  project    Project   @relation(fields: [projectId], references: [id])
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  contractId Int?
  contract   Contract? @relation(fields: [contractId], references: [id])

  // Application Details
  applicationNumber Int? // Sequential per contract: 1, 2, 3...
  applicationNo     String // e.g. "PA-001", "AFP-2025-00012" (unique per tenant)
  reference         String? // Alternative reference
  title             String? // "Payment Application #3 - May 2025"

  // Dates (Critical for Act compliance)
  applicationDate  DateTime // When contractor submits
  valuationDate    DateTime? // Cut-off for measuring work (assessment date)
  dueDate          DateTime? // When payment becomes due (7-14 days)
  finalPaymentDate DateTime? // Last day to pay (21-28 days from due)

  // Legacy period dates (keep for compatibility)
  periodStart    DateTime?
  periodEnd      DateTime?
  assessmentDate DateTime? // JCT IVD / NEC assessment date (maps to valuationDate)

  // Status
  status String // Use PaymentApplicationStatus values as strings

  // Currency
  currency String @default("GBP")

  // CONTRACTOR'S CLAIMED FIGURES
  claimedGrossValue     Decimal @default(0) @db.Decimal(12, 2)
  claimedRetention      Decimal @default(0) @db.Decimal(12, 2)
  claimedNetValue       Decimal @default(0) @db.Decimal(12, 2)
  claimedPreviouslyPaid Decimal @default(0) @db.Decimal(12, 2)
  claimedThisPeriod     Decimal @default(0) @db.Decimal(12, 2)

  // Legacy claimed fields (keep for compatibility)
  grossToDate     Decimal @default(0) @db.Decimal(18, 2)
  variationsValue Decimal @default(0) @db.Decimal(18, 2)
  prelimsValue    Decimal @default(0) @db.Decimal(18, 2)
  retentionValue  Decimal @default(0) @db.Decimal(18, 2)
  mosValue        Decimal @default(0) @db.Decimal(18, 2) // materials on site
  offsiteValue    Decimal @default(0) @db.Decimal(18, 2) // materials off site
  deductionsValue Decimal @default(0) @db.Decimal(18, 2) // contra charges
  netClaimed      Decimal @default(0) @db.Decimal(18, 2)

  // QS/COST MANAGER'S CERTIFIED FIGURES
  certifiedGrossValue     Decimal? @db.Decimal(12, 2)
  certifiedRetention      Decimal? @db.Decimal(12, 2)
  certifiedNetValue       Decimal? @db.Decimal(12, 2)
  certifiedPreviouslyPaid Decimal? @db.Decimal(12, 2)
  certifiedThisPeriod     Decimal? @db.Decimal(12, 2)

  // Legacy certification (keep for compatibility)
  certifiedAmount    Decimal?  @db.Decimal(18, 2)
  certifiedDate      DateTime?
  certifiedByUserId  Int?
  certificationNotes String?   @db.Text

  // Actual payment
  amountPaid       Decimal?  @db.Decimal(12, 2)
  paidDate         DateTime?
  paymentReference String? // Bank transfer ref, cheque number

  // Breakdown (JSON for flexibility)
  lineItems        Json? // Array of work packages valued
  variations       Json? // Variations included
  materialsOnSite  Json? // Materials stored on site
  previouslyValued Json? // Cumulative from last application

  // Documents
  submissionDocument    String? // Contractor's application PDF
  valuationDocument     String? // QS assessment/certificate
  paymentNoticeDocument String? // Formal payment notice
  payLessNoticeDocument String? // If issuing pay-less

  // Payment Certificate tracking
  paymentCertificateUrl         String? // Payment certificate PDF
  paymentCertificateGeneratedAt DateTime? // When certificate was generated
  paymentCertificateSentAt      DateTime? // When sent to subcontractor
  paymentCertificateSentBy      String? // User who sent it
  paymentCertificateSentMethod  String? // "EMAIL" | "MANUAL" | "DOWNLOAD"
  paymentCertificateSentTo      String? // Email address if sent via email

  // Notes & Comments
  contractorNotes String? @db.Text
  qsNotes         String? @db.Text
  internalNotes   String? @db.Text
  rejectionReason String? @db.Text
  notes           String? @db.Text // Legacy field

  // People
  submittedBy Int? // Contractor user/contact ID
  submittedAt DateTime?
  reviewedBy  Int? // QS/Cost manager
  reviewedAt  DateTime?
  approvedBy  Int? // Finance/PM approval
  approvedAt  DateTime?

  // Cancellation Tracking
  cancelledBy        Int? // User who cancelled
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  // Payment Notice Tracking
  paymentNoticeSent        Boolean   @default(false)
  paymentNoticeAmount      Decimal?  @db.Decimal(12, 2)
  paymentNoticeIssuedAt    DateTime? // Legacy
  paymentNoticeGeneratedAt DateTime? // When notice was generated
  paymentNoticeSentAt      DateTime? // When sent to subcontractor
  paymentNoticeSentBy      String? // User who sent it
  paymentNoticeSentMethod  String? // "EMAIL" | "MANUAL" | "DOWNLOAD"
  paymentNoticeSentTo      String? // Email address if sent via email

  // Pay-Less Notice Tracking
  payLessNoticeSent        Boolean   @default(false)
  payLessNoticeAmount      Decimal?  @db.Decimal(12, 2)
  payLessNoticeReason      String?   @db.Text
  payLessReason            String?   @db.Text // Legacy
  payLessNoticeIssuedAt    DateTime? // Legacy
  payLessNoticeGeneratedAt DateTime? // When notice was generated
  payLessNoticeSentAt      DateTime? // When sent to subcontractor (overridden from boolean flag)
  payLessNoticeSentBy      String? // User who sent it
  payLessNoticeSentMethod  String? // "EMAIL" | "MANUAL" | "DOWNLOAD"
  payLessNoticeSentTo      String? // Email address if sent via email

  // Retention Tracking
  retentionPercentage    Decimal @default(5.0) @db.Decimal(5, 2)
  retentionHeldToDate    Decimal @default(0) @db.Decimal(12, 2)
  retentionReleasedPC    Decimal @default(0) @db.Decimal(12, 2) // At Practical Completion
  retentionReleasedFinal Decimal @default(0) @db.Decimal(12, 2) // After defects period

  // Compliance & Audit
  isActCompliant  Boolean @default(true)
  complianceNotes String? @db.Text
  disputeRaised   Boolean @default(false)
  disputeDetails  String? @db.Text

  // Email Ingestion (Cloudflare Email Routing)
  sourceType           String? // "EMAIL" | "MANUAL" | "API"
  emailSender          String? // Sender email address
  emailSubject         String? // Email subject line
  emailBody            String?   @db.Text // Email body text
  emailReceivedAt      DateTime? // When email was received
  emailMessageId       String? // Unique email ID from Cloudflare
  emailAttachmentCount Int? // Number of attachments in email

  // OCR Processing (AWS Textract)
  ocrStatus        String? // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED" | "SKIPPED"
  ocrStartedAt     DateTime?
  ocrCompletedAt   DateTime?
  ocrError         String?   @db.Text
  ocrRawText       String?   @db.Text // Full extracted text from Textract
  ocrConfidence    Decimal?  @db.Decimal(5, 2) // Overall confidence score (0-100)
  ocrS3Key         String? // S3 key for original PDF
  ocrS3Bucket      String? // S3 bucket name
  ocrJobId         String? // AWS Textract job ID
  ocrExtractedData Json? // Structured data extracted from OCR

  // Contract Matching
  contractMatchMethod     String? // "AUTO_MATCHED" | "SUGGESTED" | "MANUAL"
  contractMatchConfidence Decimal?  @db.Decimal(5, 2) // Matching confidence (0-100)
  suggestedContracts      Json? // Array of suggested contract IDs with scores
  contractMatchedAt       DateTime?
  contractMatchedBy       Int? // User who confirmed the match

  // Auto-Population Flags
  autoPopulated  Boolean   @default(false) // Was this created from OCR?
  requiresReview Boolean   @default(false) // QS needs to review OCR data
  ocrReviewedBy  Int?
  ocrReviewedAt  DateTime?
  ocrReviewNotes String?   @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  attachments     AfpAttachment[]
  lineItemDetails PaymentApplicationLineItem[]
  purchaseOrders  PurchaseOrder[]
  invoices        Invoice[] // Certificate-Invoice matching (Phase B)
  certificate     PaymentCertificate? // Task 3.1: Certificate received for this application

  // Invoice tracking (Phase B)
  invoiceReceivedAt DateTime?
  invoiceId         Int? // Primary matched invoice

  // Payment tracking (Phase C)
  payments         PaymentRecord[]
  totalPaid        Decimal?        @db.Decimal(15, 2)
  paidInFull       Boolean         @default(false)
  paidAt           DateTime?
  remainingBalance Decimal?        @db.Decimal(15, 2)

  // CIS (Construction Industry Scheme) - Task 1.4
  labourElement    Decimal?  @db.Decimal(15, 2) // Labour portion for CIS calculation
  materialsElement Decimal?  @db.Decimal(15, 2) // Materials portion (not subject to CIS)
  cisStatus        String? // GROSS | NET | UNVERIFIED | NOT_APPLICABLE
  cisRate          Decimal?  @db.Decimal(5, 2) // 0, 20, or 30
  cisDeduction     Decimal?  @db.Decimal(15, 2) // Amount deducted for CIS
  netAfterCIS      Decimal?  @db.Decimal(15, 2) // Net payment after CIS deduction
  cisCalculatedAt  DateTime? // When CIS was last calculated
  cisWarnings      String? // JSON array of warning messages

  // VAT (Value Added Tax) - Task 1.5
  vatTreatment      String? // STANDARD | REVERSE_CHARGE | ZERO_RATED | EXEMPT
  vatRate           Decimal? @db.Decimal(5, 2) // 20, 5, 0, or null for reverse charge
  vatAmount         Decimal? @db.Decimal(15, 2) // VAT charged (0 for reverse charge)
  grossWithVAT      Decimal? @db.Decimal(15, 2) // Total including VAT (netAfterCIS + vatAmount)
  reverseCharge     Boolean  @default(false) // Is this a reverse charge transaction?
  reverseChargeNote String? // Required wording: "Reverse charge: Customer to account for VAT to HMRC"

  // Main Contractor Discount - Task 1.6
  mcdPercentage Decimal? @db.Decimal(5, 2) // MC discount % from contract (0-100)
  mcdAmount     Decimal? @db.Decimal(15, 2) // Discount amount deducted
  grossAfterMCD Decimal? @db.Decimal(15, 2) // Gross after MCD deduction (before retention/CIS)

  // Task 2.4: Payment Application Direction
  direction String @default("INBOUND") // INBOUND (from sub to you), OUTBOUND (you to MC/client)

  // For OUTBOUND - who are we sending to?
  recipientType      String? // CLIENT, MAIN_CONTRACTOR
  recipientId        Int? // FK to Client record
  recipientContactId Int? // FK to Contact - who receives it

  // For OUTBOUND - link to upstream contract (our contract with MC/client)
  upstreamContractId String? // FK to UpstreamContract

  // Submission tracking (for OUTBOUND applications)
  submittedVia     String? // EMAIL, PORTAL, POST, HAND_DELIVERED
  submittedToEmail String? // Email address where submitted
  submittedNotes   String? @db.Text // Notes about submission

  // Relations for direction
  upstreamContract UpstreamContract? @relation(fields: [upstreamContractId], references: [id])
  recipient        Client?           @relation("ApplicationRecipient", fields: [recipientId], references: [id])
  recipientContact Contact?          @relation("ApplicationRecipientContact", fields: [recipientContactId], references: [id])

  // Task 2.6: Status Tracking & History
  queriedAt     DateTime? // When application was queried
  resubmittedAt DateTime? // When re-submitted after query
  withdrawnAt   DateTime? // When application was withdrawn

  // Status change metadata
  queriedById      String? // User who queried the application
  queryDetails     String? @db.Text // Details of the query
  withdrawnById    String? // User who withdrew the application
  withdrawalReason String? @db.Text // Reason for withdrawal

  // Audit trail
  statusHistory PaymentApplicationStatusHistory[]

  @@unique([tenantId, applicationNo])
  @@index([contractId, applicationNumber])
  @@index([tenantId, projectId, applicationDate])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([contractId, status])
  @@index([projectId, status])
  @@index([dueDate])
  @@index([finalPaymentDate])
  @@index([tenantId, contractId, applicationNumber])
  @@index([tenantId, projectId, direction])
}

model AfpAttachment {
  id         Int      @id @default(autoincrement())
  tenantId   String
  afpId      Int
  documentId BigInt
  label      String?
  createdAt  DateTime @default(now())

  afp ApplicationForPayment @relation(fields: [afpId], references: [id])
  // Document.id remains BigInt elsewhere
}

// ==============================================================================
// Payment Application Status History - Task 2.6
// ==============================================================================
model PaymentApplicationStatusHistory {
  id                   String @id @default(cuid())
  tenantId             String
  paymentApplicationId Int

  fromStatus  String? // Previous status (null if first status)
  toStatus    String // New status
  changedAt   DateTime @default(now())
  changedById Int // User ID who made the change
  notes       String?  @db.Text // Optional notes about the change
  metadata    Json? // Additional context (e.g., submission method, email, etc.)

  paymentApplication ApplicationForPayment @relation(fields: [paymentApplicationId], references: [id], onDelete: Cascade)
  changedBy          User                  @relation("PaymentApplicationStatusHistoryChangedBy", fields: [changedById], references: [id])

  @@index([tenantId])
  @@index([paymentApplicationId])
  @@index([changedAt])
}

// ==============================================================================
// Payment Application Line Items - Detailed BOQ valuations
// ==============================================================================
model PaymentApplicationLineItem {
  id       Int    @id @default(autoincrement())
  tenantId String

  applicationId Int
  application   ApplicationForPayment @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // INBOUND: Link to contract package
  packageId Int?

  // Task 2.5: OUTBOUND - Link to our budget line
  budgetLineId Int?
  budgetLine   BudgetLine? @relation(fields: [budgetLineId], references: [id])

  description String
  reference   String? // BOQ item reference

  // Task 2.5: Contract/original budgeted value for this line
  contractValue Decimal? @db.Decimal(12, 2)

  // Quantities
  quantityPrevious   Decimal? @db.Decimal(12, 4)
  quantityThisPeriod Decimal? @db.Decimal(12, 4)
  quantityCumulative Decimal? @db.Decimal(12, 4)
  unit               String?

  // Values
  rate            Decimal? @db.Decimal(12, 4)
  valuePrevious   Decimal  @default(0) @db.Decimal(12, 2)
  valueThisPeriod Decimal  @default(0) @db.Decimal(12, 2)
  valueCumulative Decimal  @default(0) @db.Decimal(12, 2)

  // QS Assessment (if different from claimed)
  qsCertifiedQuantity Decimal? @db.Decimal(12, 4)
  qsCertifiedValue    Decimal? @db.Decimal(12, 2)
  qsNotes             String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, applicationId])
  @@index([packageId])
  @@index([budgetLineId])
}

// ==============================================================================
// Payment Certificates - Task 3.1
// ==============================================================================
// Certificates received from Main Contractor in response to OUTBOUND applications
model PaymentCertificate {
  id       String @id @default(cuid())
  tenantId String

  projectId Int

  // Task 2.5: Certificate Direction
  direction String @default("INBOUND") // INBOUND (certificates we receive from MC/client)

  upstreamContractId String

  // Link to application this responds to
  paymentApplicationId Int? @unique // Nullable - might receive cert without app in system

  // Certificate details
  certificateNumber Int
  certificateRef    String? // MC's reference if different
  certificateDate   DateTime
  receivedDate      DateTime @default(now())

  // Amounts - what MC certified
  certifiedGross Decimal @db.Decimal(15, 2) // Gross amount they certified

  // Deductions applied by MC
  retentionPercentage Decimal? @db.Decimal(5, 2)
  retentionAmount     Decimal  @default(0) @db.Decimal(15, 2)
  mcdPercentage       Decimal? @db.Decimal(5, 2)
  mcdAmount           Decimal  @default(0) @db.Decimal(15, 2)
  cisRate             Decimal? @db.Decimal(5, 2)
  cisAmount           Decimal  @default(0) @db.Decimal(15, 2)
  otherDeductions     Decimal  @default(0) @db.Decimal(15, 2)
  otherDeductionsDesc String?  @db.Text

  // Net payable
  netCertified Decimal @db.Decimal(15, 2) // Gross - all deductions

  // Cumulative tracking
  cumulativeGross        Decimal? @db.Decimal(15, 2) // Total certified to date
  cumulativeRetention    Decimal? @db.Decimal(15, 2) // Total retention held to date
  cumulativeNetCertified Decimal? @db.Decimal(15, 2) // Total net certified to date

  // Variance from application
  appliedGross       Decimal? @db.Decimal(15, 2) // What you applied for (from linked app)
  varianceAmount     Decimal? @db.Decimal(15, 2) // Certified - Applied (negative if less)
  variancePercentage Decimal? @db.Decimal(5, 2) // Variance as percentage
  varianceNotes      String?  @db.Text // MC's reason for difference

  // Payment tracking
  paymentDueDate DateTime // Calculated from contract terms
  paymentStatus  String   @default("AWAITING") // AWAITING, PAID, OVERDUE, PARTIAL, DISPUTED

  // Payment summary (Task 3.3 - calculated fields updated when payments recorded)
  totalPaid        Decimal   @default(0) @db.Decimal(15, 2)
  totalOutstanding Decimal?  @db.Decimal(15, 2) // netCertified - totalPaid
  lastPaymentDate  DateTime? // Date of most recent payment

  // Document
  certificateDocumentUrl String? // Uploaded certificate PDF

  // Status
  status       String  @default("RECEIVED") // RECEIVED, DISPUTED, ACCEPTED
  disputeNotes String? @db.Text

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?

  // Relations
  project            Project                @relation(fields: [projectId], references: [id])
  upstreamContract   UpstreamContract       @relation(fields: [upstreamContractId], references: [id])
  paymentApplication ApplicationForPayment? @relation(fields: [paymentApplicationId], references: [id])
  createdBy          User?                  @relation("PaymentCertificateCreatedBy", fields: [createdById], references: [id])
  payments           CertificatePayment[]

  @@unique([tenantId, projectId, certificateNumber])
  @@index([tenantId])
  @@index([projectId])
  @@index([paymentApplicationId])
  @@index([paymentStatus])
  @@index([paymentDueDate])
  @@index([tenantId, projectId, direction])
}

// Track payments received against certificates
model CertificatePayment {
  id                   String @id @default(cuid())
  tenantId             String
  paymentCertificateId String

  // Payment details
  paymentDate      DateTime
  paymentAmount    Decimal  @db.Decimal(15, 2)
  paymentReference String? // Bank ref / BACS ref
  paymentMethod    String? // BACS, CHEQUE, FASTER_PAYMENT, CHAPS, CASH, CARD, OTHER

  // Bank matching (Task 3.3)
  bankAccountId      String? // If integrated with bank feeds
  bankTransactionRef String? // Reference from bank statement

  // Allocation (Task 3.3)
  isPartialPayment Boolean @default(false)

  // Document
  remittanceDocumentUrl String? // Uploaded remittance advice

  // Notes
  notes String? @db.Text

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?

  // Relations
  paymentCertificate PaymentCertificate @relation(fields: [paymentCertificateId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation("CertificatePaymentCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([paymentCertificateId])
  @@index([paymentDate])
}

// ==============================================================================
// Payment Records - Track actual payments made (Phase C)
// ==============================================================================
model PaymentRecord {
  id       Int    @id @default(autoincrement())
  tenantId String

  // Link to payment application
  paymentApplicationId Int
  paymentApplication   ApplicationForPayment @relation(fields: [paymentApplicationId], references: [id])

  // Payment details
  amount           Decimal  @db.Decimal(15, 2)
  paymentDate      DateTime
  paymentMethod    String // "BACS", "CHEQUE", "CARD", "CASH", "DIRECT_DEBIT"
  paymentReference String? // BACS ref, cheque number, transaction ID, etc.

  // Bank details (optional - for audit)
  bankAccount String? // Which account paid from

  // Deductions applied
  retentionDeducted   Decimal? @db.Decimal(15, 2)
  cisDeducted         Decimal? @db.Decimal(15, 2)
  otherDeductions     Decimal? @db.Decimal(15, 2)
  otherDeductionsNote String?

  // Status
  status String @default("COMPLETED") // "PENDING", "COMPLETED", "FAILED", "REVERSED"

  // Audit
  createdAt DateTime @default(now())
  createdBy String
  notes     String?

  @@index([tenantId])
  @@index([paymentApplicationId])
  @@index([paymentDate])
  @@index([status])
}

// ==============================================================================
// Retention Releases - Practical Completion & Final Account
// ==============================================================================
model RetentionRelease {
  id       Int    @id @default(autoincrement())
  tenantId String

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])

  releaseType   String // Use RetentionReleaseType values
  releaseAmount Decimal  @db.Decimal(12, 2)
  releaseDate   DateTime

  // Trigger events
  practicalCompletionDate DateTime?
  defectsEndDate          DateTime?

  approvedBy Int?
  approvedAt DateTime?

  notes    String? @db.Text
  document String? // Certificate/approval doc

  createdAt DateTime @default(now())

  @@index([tenantId, contractId])
  @@index([releaseDate])
}

/// Finance: OCR job queue (additive)
model OcrJob {
  id         Int      @id @default(autoincrement())
  tenantId   String   @default("demo")
  documentId BigInt
  kind       String   @default("invoice") // invoice|po
  status     String   @default("queued") // queued|processing|done|failed
  provider   String?
  resultJson Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
