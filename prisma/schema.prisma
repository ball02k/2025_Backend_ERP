// NEW: Contract Type definitions for standardizing contract terms
model ContractType {
  id          String  @id @default(cuid())
  tenantId    String  @default("demo")
  name        String // "NEC4 ECC Option A", "JCT D&B 2016"
  framework   String? // "NEC4" | "JCT" | "FIDIC" | "BESPOKE"
  category    String? // "PRICED_CONTRACT" | "TARGET_COST" | "COST_REIMBURSABLE" | "MANAGEMENT"
  description String? @db.Text

  // Payment characteristics
  paymentBasis  String? // "LUMP_SUM" | "REMEASUREMENT" | "COST_PLUS" | "MILESTONE"
  retentionRate Decimal? @db.Decimal(5, 2) // e.g. 5.00 for 5%
  paymentTerms  String?  @db.Text // "Net 30 days from valuation"

  // PO Strategy suggestion
  suggestedPOStrategy String? // "SINGLE_ON_AWARD" | "MILESTONE_BASED" | "CALL_OFF"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
