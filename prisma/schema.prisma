model Contract {
  id        Int  @id @default(autoincrement())
  projectId Int
  packageId Int?

  // Task 2.5: Contract Direction
  direction String @default("DOWNSTREAM") // UPSTREAM (our contract with MC/client), DOWNSTREAM (subcontracts we issue)

  supplierId          Int
  title               String
  contractRef         String?
  value               Decimal   @db.Decimal(65, 30)
  currency            String?   @default("GBP")
  status              String    @default("draft")
  signedAt            DateTime?
  startDate           DateTime?
  endDate             DateTime?
  retentionPct        Decimal?  @db.Decimal(5, 2)
  // Labour/Materials split for CIS calculation (nullable = use supplier default)
  labourPercentage    Decimal?  @db.Decimal(5, 2) // Override supplier default (0-100)
  materialsPercentage Decimal?  @db.Decimal(5, 2) // Calculated as 100 - labourPercentage

  // VAT Treatment - Task 1.5
  vatTreatment String?  @default("STANDARD") // STANDARD | REVERSE_CHARGE | ZERO_RATED | EXEMPT
  isEndUser    Boolean? @default(false) // Is counterparty an end user? (affects reverse charge)

  // Main Contractor Discount - Task 1.6
  mainContractorDiscount Decimal? @default(0) @db.Decimal(5, 2) // MC discount % (0-100)
  mcdDescription         String? // Description of discount (e.g., "Site attendance")

  paymentTerms    String?
  notes           String?
  internalTeam    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  originalValue   Decimal? @db.Decimal(18, 2)
  managedByUserId Int?
  pdfUrl          String?
  tenantId        String?

  // Document source tracking
  documentSource           String?   @default("NONE") // NONE | GENERATED | UPLOADED_DRAFT | UPLOADED_SIGNED
  draftDocumentUrl         String? // URL to draft document in Oracle Cloud Storage
  draftDocumentName        String? // Original filename
  signedDocumentUrl        String? // URL to signed document
  signedDocumentName       String? // Original filename
  signedDocumentUploadedAt DateTime?
  signedDocumentUploadedBy String?

  // OCR tracking (for uploaded signed contracts)
  ocrStatus        String?   @default("NONE") // NONE | PROCESSING | COMPLETED | FAILED
  ocrRawText       String?   @db.Text // Full extracted text from PDF
  ocrExtractedData Json? // Parsed fields: { contractValue: { value, confidence }, ... }
  ocrConfidence    Float? // Overall confidence score
  ocrReviewedBy    String? // User ID who confirmed OCR data
  ocrReviewedAt    DateTime?
  ocrReviewNotes   String? // Any notes from reviewer

  // Contract lifecycle tracking
  issuedAt DateTime?
  issuedBy String?
  signedBy String?

  // NEW: Contract Type linking
  contractTypeId String?

  rfxId          Int?      @unique
  awardId        Int?      @unique
  draftCreatedAt DateTime?
  lockedAt       DateTime?
  sourceMode     String?

  // Payment Application Settings (UK Construction Act)
  paymentFrequency    String   @default("MONTHLY") // MONTHLY, MILESTONE, STAGE
  paymentDueDays      Int      @default(14) // Days from valuation to due date
  paymentFinalDays    Int      @default(21) // Days from due date to final date
  retentionPercentage Decimal  @default(5.0) @db.Decimal(5, 2)
  retentionLimit      Decimal? @db.Decimal(12, 2) // Max retention amount (cap)

  // Payment Application Tracking
  valuationDayOfMonth Int? // e.g., 25 (last Friday approximation)
  nextApplicationDue  DateTime?

  // Cumulative Financial Tracking
  totalCertifiedToDate Decimal @default(0) @db.Decimal(12, 2) // Total certified value across all applications
  totalPaidToDate      Decimal @default(0) @db.Decimal(12, 2) // Total actually paid
  retentionHeld        Decimal @default(0) @db.Decimal(12, 2) // Current retention held
  retentionReleased    Decimal @default(0) @db.Decimal(12, 2) // Retention released

  // relations
  project            Project                 @relation(fields: [projectId], references: [id])
  package            Package?                @relation(fields: [packageId], references: [id])
  supplier           Supplier                @relation(fields: [supplierId], references: [id])
  rfx                Rfx?                    @relation("ContractRfx", fields: [rfxId], references: [id])
  award              Award?                  @relation("ContractAward", fields: [awardId], references: [id])
  lineItems          ContractLineItem[]
  applications       ApplicationForPayment[]
  invoices           Invoice[]
  purchaseOrders     PurchaseOrder[]
  documents          ContractDocument[]
  approvalSteps      ContractApprovalStep[]
  approvals          ContractApproval[]
  files              ContractFile[]
  retentionReleases  RetentionRelease[]
  contractValuations ContractValuation[]     @relation("ContractValuations")
  variations         Variation[]

  // NEW: Contract Type and Milestone relations
  contractType ContractType?      @relation(fields: [contractTypeId], references: [id])
  milestones   PackageMilestone[]

  @@index([projectId])
  @@index([supplierId])
  @@index([tenantId])
  @@index([packageId])
  @@index([tenantId, packageId])
  @@index([tenantId, projectId, direction])
}

