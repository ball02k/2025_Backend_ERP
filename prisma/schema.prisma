model PurchaseOrder {
  id        Int    @id @default(autoincrement())
  tenantId  String @default("demo")
  projectId Int

  // Task 2.5: Purchase Order Direction
  direction String @default("OUTBOUND") // OUTBOUND (POs we issue to subs), INBOUND (POs we receive from MC/client - rare)

  code          String
  supplier      String
  supplierId    Int?
  contractId    Int?
  budgetLineId  Int? // CVR: Link to budget line
  status        String    @default("DRAFT") // "DRAFT" | "SUBMITTED" | "APPROVED" | "ISSUED" | "SENT" | "ACKNOWLEDGED" | "GOODS_RECEIVED" | "INVOICE_RECEIVED" | "PARTIALLY_PAID" | "PAID" | "CANCELLED"
  orderDate     DateTime  @default(now())
  total         Decimal   @default(0)
  // CVR: Enhanced workflow tracking
  submittedDate DateTime?
  approvedDate  DateTime?
  approvedBy    Int?
  issuedDate    DateTime?
  cancelledDate DateTime?
  cancelReason  String?

  // Supplier communication tracking
  sentAt         DateTime?
  sentBy         String?
  sentMethod     String? // "EMAIL" | "DOWNLOAD" | "MANUAL"
  acknowledgedAt DateTime?

  // Payment tracking
  paidAt     DateTime?
  paidAmount Decimal?  @default(0)

  // NEW: PO Strategy & Milestone Support
  poType          String? @default("FULL_CONTRACT") // "FULL_CONTRACT" | "MILESTONE" | "CALL_OFF"
  milestoneId     Int?
  milestoneNumber Int? // Which milestone (1, 2, 3...)

  // NEW: Package linking
  packageId Int?

  // NEW: Payment Application linking
  paymentApplicationId Int?

  // NEW: PDF tracking
  pdfUrl         String? // Link to generated PDF
  pdfGeneratedAt DateTime?

  // NEW: Delivery tracking
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  deliveryStatus       String?   @default("PENDING") // "PENDING" | "PARTIAL" | "COMPLETE"

  // NEW: Enhanced notes
  internalNotes String? @db.Text
  supplierNotes String? @db.Text

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  project            Project                @relation(fields: [projectId], references: [id])
  contract           Contract?              @relation(fields: [contractId], references: [id])
  budgetLine         BudgetLine?            @relation(fields: [budgetLineId], references: [id])
  package            Package?               @relation(fields: [packageId], references: [id])
  milestone          PackageMilestone?      @relation(fields: [milestoneId], references: [id])
  paymentApplication ApplicationForPayment? @relation(fields: [paymentApplicationId], references: [id])
  lines              POLine[]
  deliveries         Delivery[]

  @@unique([tenantId, code])
  @@index([tenantId, projectId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, contractId])
  @@index([tenantId, budgetLineId])
  @@index([tenantId, projectId, direction])
}

