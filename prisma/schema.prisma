model JobStatusHistory {
  id       String @id @default(uuid())
  tenantId String
  jobId    String

  // Status Change
  oldStatus    JobStatus
  newStatus    JobStatus
  changeReason String?   @db.Text

  // User Info
  changedBy String // User ID
  changedAt DateTime @default(now())

  // Additional Context
  additionalData Json?

  // Relations
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

