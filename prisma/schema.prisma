  tenantId         String
  name             String // "Balfour Beatty Standard Format"
  mainContractorId Int? // Optional - tie to specific MC
  mappings         Json // { reference: "Item Ref", description: "Description", ... }
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mainContractor Client? @relation("ImportMappingMainContractor", fields: [mainContractorId], references: [id])

  @@index([tenantId])
  @@index([mainContractorId])
}

model Commitment {
