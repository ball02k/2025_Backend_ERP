  DISCONTINUED
  OUT_OF_STOCK
  LOW_STOCK
  INACTIVE
}

enum ReservationStatus {
  RESERVED
  ALLOCATED
  RELEASED
  USED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  DISPUTED
}

enum POItemStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// Master Inventory Item
model InventoryItem {
  id       String @id @default(uuid())
  tenantId String

  // Item Details
  itemNumber    String  @unique
  itemName      String
  sku           String?
  description   String? @db.Text
  category      String?
  manufacturer  String?
  model         String?
  partNumber    String?
  barcode       String?
  unitOfMeasure String  @default("each")

  // Stock Levels
  quantityInStock   Decimal  @default(0) @db.Decimal(12, 2)
  quantityReserved  Decimal  @default(0) @db.Decimal(12, 2)
  quantityAvailable Decimal  @default(0) @db.Decimal(12, 2) // InStock - Reserved
  reorderLevel      Decimal  @default(0) @db.Decimal(12, 2)
  reorderQuantity   Decimal  @default(0) @db.Decimal(12, 2)
  minimumStockLevel Decimal  @default(0) @db.Decimal(12, 2)
  maximumStockLevel Decimal? @db.Decimal(12, 2)

  // Costing
  unitCost          Decimal? @db.Decimal(12, 2)
  lastPurchasePrice Decimal? @db.Decimal(12, 2)
  averageCost       Decimal? @db.Decimal(12, 2)
  standardCost      Decimal? @db.Decimal(12, 2)

  // Location & Status
  warehouseLocation String?
  binLocation       String?
  status            InventoryItemStatus @default(ACTIVE)

  // Supplier Info
  primarySupplierId  String?
  supplierPartNumber String?
  leadTimeDays       Int? // Days to receive from supplier

  // Auto-PO Settings
  autoReorderEnabled Boolean @default(false)
  autoGeneratePO     Boolean @default(false)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastRestockedAt DateTime?
  isDeleted       Boolean   @default(false)

  // Relations
  reservations       InventoryReservation[]
  jobMaterials       JobMaterial[]
  purchaseOrderItems InventoryPurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@index([tenantId, status])
  @@index([tenantId, itemNumber])
  @@index([tenantId, sku])
  @@map("inventory_items")
}

// Stock Reservations for Jobs
model InventoryReservation {
  id       String @id @default(uuid())
  tenantId String

  // Links
  inventoryItemId String
  jobId           String
  jobMaterialId   String?

  // Reservation Details
  quantityReserved Decimal @db.Decimal(12, 2)
  quantityUsed     Decimal @default(0) @db.Decimal(12, 2)
  quantityReleased Decimal @default(0) @db.Decimal(12, 2)

  // Status
  status ReservationStatus @default(RESERVED)

  // Dates
  reservedDate   DateTime  @default(now())
  requiredByDate DateTime?
  allocatedDate  DateTime?
  releasedDate   DateTime?

  // Audit
  reservedBy String
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@index([tenantId, inventoryItemId])
  @@index([tenantId, status])
  @@map("inventory_reservations")
}

// Inventory Purchase Orders (for job materials/stock replenishment)
model InventoryPurchaseOrder {
  id       String @id @default(uuid())
  tenantId String

  // PO Details
  poNumber    String  @unique
  title       String?
  description String? @db.Text

  // Supplier
  supplierId      String?
  supplierName    String
  supplierContact String?
  supplierEmail   String?
  supplierPhone   String?

  // Delivery
  deliveryAddress String?   @db.Text
  deliveryDate    DateTime?
  requestedDate   DateTime?

  // Financial
  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal @default(0) @db.Decimal(12, 2)
  currency     String  @default("GBP")

  // Status & Tracking
  status   PurchaseOrderStatus @default(DRAFT)
  priority String              @default("NORMAL") // LOW, NORMAL, HIGH, URGENT

  // Auto-generation flags
  autoGenerated   Boolean @default(false)
  generatedReason String? @db.Text // e.g., "Stock below reorder level for Item XYZ"
  jobId           String? // Link to job if PO created for specific job

  // Dates
  orderDate        DateTime?
  sentDate         DateTime?
  acknowledgedDate DateTime?
  expectedDate     DateTime?
  receivedDate     DateTime?

  // Audit
  createdBy          String
  approvedBy         String?
  approvedAt         DateTime?
  cancelledBy        String?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  // Relations
  items InventoryPurchaseOrderItem[]
  job   Job?                         @relation(fields: [jobId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, poNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, jobId])
  @@map("inventory_purchase_orders")
}

// Inventory Purchase Order Line Items
model InventoryPurchaseOrderItem {
  id       String @id @default(uuid())
  tenantId String

  // Links
  purchaseOrderId String
  inventoryItemId String?

  // Item Details (duplicated for history)
  itemName      String
  itemSKU       String?
  description   String? @db.Text
  partNumber    String?
  unitOfMeasure String  @default("each")

  // Quantities
  quantityOrdered  Decimal @db.Decimal(12, 2)
  quantityReceived Decimal @default(0) @db.Decimal(12, 2)
  quantityReturned Decimal @default(0) @db.Decimal(12, 2)

  // Pricing
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)

  // Status
  status POItemStatus @default(PENDING)

  // Dates
  expectedDate DateTime?
  receivedDate DateTime?

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  purchaseOrder InventoryPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?         @relation(fields: [inventoryItemId], references: [id])

  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, inventoryItemId])
  @@map("inventory_purchase_order_items")
}

// Stock Movement History
model StockMovement {
  id       String @id @default(uuid())
  tenantId String

  // Item
  inventoryItemId String

  // Movement Details
  movementType   String // PURCHASE, JOB_ALLOCATION, JOB_RETURN, ADJUSTMENT, TRANSFER, DAMAGE, LOSS
  quantityChange Decimal @db.Decimal(12, 2) // Positive for increase, negative for decrease
  quantityBefore Decimal @db.Decimal(12, 2)
  quantityAfter  Decimal @db.Decimal(12, 2)

  // Context
  referenceType   String? // JOB, PURCHASE_ORDER, ADJUSTMENT, etc.
  referenceId     String? // ID of the related record
  jobId           String?
  purchaseOrderId String?

  // Location
  fromLocation String?
  toLocation   String?

  // Reason & Audit
  reason      String?  @db.Text
  performedBy String
  performedAt DateTime @default(now())

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  job           Job?          @relation(fields: [jobId], references: [id])

  @@index([tenantId, inventoryItemId])
  @@index([tenantId, jobId])
  @@index([tenantId, performedAt])
  @@map("stock_movements")
}
