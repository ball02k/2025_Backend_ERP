generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  shadowDatabaseUrl = env("PRISMA_MIGRATE_SHADOW_DATABASE_URL")
}

// ==========================================
// FLEXIBLE PRICING SYSTEM - ENUMS
// ==========================================

enum PricingMode {
  LUMP_SUM // Single price, no breakdown
  MEASURED // Full BOQ with unit rates required
  HYBRID // Package total + optional breakdown (recommended)
}

enum ResponsePricingType {
  LUMP_SUM_ONLY // Supplier provided package total only
  ITEMIZED_ONLY // Supplier provided full breakdown only
  HYBRID_WITH_BREAKDOWN // Supplier provided both total and breakdown
}

enum UserRoleEnum {
  dev
  user
  admin
}

// ==============================================================================
// PAYMENT APPLICATIONS SYSTEM - UK CONSTRUCTION ACT COMPLIANT
// ==============================================================================

enum PaymentApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CERTIFIED
  PAYMENT_NOTICE_SENT
  PAY_LESS_ISSUED
  APPROVED
  PAID
  PARTIALLY_PAID
  DISPUTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum RetentionReleaseType {
  PRACTICAL_COMPLETION
  FINAL_ACCOUNT
  EARLY_RELEASE
  RETENTION_BOND
}

// CVR Phase B: Forecast enums
enum ForecastMethod {
  COMMITTED // Forecast = Committed (default, no manual adjustment)
  MANUAL // QS manually set the anticipated final
  COMMITTED_PLUS_ADJ // Forecast = Committed + Manual Adjustment
  CALCULATED // System calculated based on trends
}

enum ForecastStatus {
  ON_TRACK // Forecast ≤ Budget
  AT_RISK // Forecast within 5% over budget
  OVER_BUDGET // Forecast > Budget
  UNDER_BUDGET // Forecast significantly under budget (>10%)
  REQUIRES_REVIEW // Flagged for QS review
}

enum ForecastChangeType {
  MANUAL_ADJUSTMENT // QS manually changed forecast
  CONTRACT_AWARDED // New contract affected forecast
  VARIATION_APPROVED // Variation approval changed forecast
  PERIOD_END_REVIEW // Monthly/quarterly forecast review
  SYSTEM_RECALCULATION // Automated recalculation
  INITIAL_SETUP // First forecast set
}

// Supplier Onboarding
model OnboardingProject {
  id        Int      @id @default(autoincrement())
  tenantId  String
  name      String
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
}

model OnboardingForm {
  id          Int     @id @default(autoincrement())
  tenantId    String
  projectId   Int
  title       String
  version     String  @default("v1")
  isPublished Boolean @default(false)
  sections    Json?

  @@index([tenantId, projectId])
}

model OnboardingInvite {
  id          Int       @id @default(autoincrement())
  tenantId    String
  projectId   Int
  supplierId  Int
  email       String
  token       String
  status      String    @default("invited")
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([tenantId, projectId, status])
}

model OnboardingResponse {
  id          Int       @id @default(autoincrement())
  tenantId    String
  projectId   Int
  supplierId  Int? // link to Supplier when approved
  formId      Int
  answers     Json
  files       Json?
  status      String    @default("in_progress")
  submittedAt DateTime?
  reviewedBy  Int?
  reviewedAt  DateTime?
  decision    String?

  @@index([tenantId, projectId, supplierId, status])
}

model ProjectStatus {
  id        Int       @id @default(autoincrement())
  tenantId  Int?
  key       String
  label     String
  colorHex  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  projects  Project[] @relation("ProjectStatusRel")

  @@unique([tenantId, key])
}

model ProjectType {
  id        Int       @id @default(autoincrement())
  tenantId  Int?
  key       String
  label     String
  colorHex  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  projects  Project[] @relation("ProjectTypeRel")

  @@unique([tenantId, key])
}

model TaskStatus {
  id        Int     @id @default(autoincrement())
  tenantId  Int?
  key       String
  label     String
  colorHex  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  tasks     Task[]  @relation("TaskStatusRel")

  @@unique([tenantId, key])
}

model Client {
  id           Int     @id @default(autoincrement())
  name         String
  companyRegNo String?
  vatNo        String?
  address1     String?
  address2     String?
  city         String?
  county       String?
  postcode     String?

  // Task 2.1: Support dual role - same entity can be client AND main contractor
  clientType String @default("CLIENT") // CLIENT, MAIN_CONTRACTOR, BOTH

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
  contacts  Contact[] // REQUIRED for includes/counts

  // Task 2.1: Projects where this Client is the upstream party (MC or client)
  upstreamProjects Project[] @relation("UpstreamParty")

  // Task 2.2: Upstream contracts where this Client is the main contractor
  upstreamContractsAsMC UpstreamContract[] @relation("UpstreamContractMainContractor")

  // Task 2.3: Import mappings for this main contractor
  importMappings ImportMapping[] @relation("ImportMappingMainContractor")

  // Task 2.4: Applications where this Client is the recipient
  applicationsAsRecipient ApplicationForPayment[] @relation("ApplicationRecipient")

  @@index([name])
  @@index([vatNo])
  @@index([companyRegNo])
  @@index([clientType])
}

model Project {
  id          Int     @id @default(autoincrement())
  tenantId    String  @default("demo")
  code        String  @unique
  name        String
  description String?

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  // Legacy lookup relations (retain for compatibility)
  statusId  Int?
  statusRel ProjectStatus? @relation("ProjectStatusRel", fields: [statusId], references: [id])
  typeId    Int?
  typeRel   ProjectType?   @relation("ProjectTypeRel", fields: [typeId], references: [id])

  // Simple string fields for lean project
  status           String   @default("Active")
  type             String   @default("General")
  projectManagerId Int?
  country          String?
  currency         String?
  unitSystem       String?
  taxScheme        String?
  contractForm     String?
  // Additive project info fields
  clientContactId  Int?
  sitePostcode     String?
  siteLat          Decimal? @db.Decimal(10, 7)
  siteLng          Decimal? @db.Decimal(10, 7)
  // commercial basics (additive)
  contractType     String?
  paymentTermsDays Int?
  retentionPct     Decimal? @db.Decimal(5, 2)

  // internal roles (additive)
  projectManagerUserId   Int?
  quantitySurveyorUserId Int?
  startPlanned           DateTime?
  endPlanned             DateTime?
  startActual            DateTime?
  endActual              DateTime?
  labels                 Json?

  // Task 2.1: Project role determines workflow and capabilities
  projectRole String @default("PRINCIPAL_CONTRACTOR") // PRINCIPAL_CONTRACTOR, SUBCONTRACTOR, DIRECT_TO_CLIENT

  // Upstream party (who you report to) - used when SUBCONTRACTOR or DIRECT_TO_CLIENT
  upstreamPartyType   String? // CLIENT, MAIN_CONTRACTOR
  upstreamPartyId     Int? // FK to Client record (Client can represent both clients and MCs)
  upstreamContactId   Int? // FK to Contact - primary person for submissions
  upstreamContractRef String? // Their reference for this contract/project
  upstreamPoNumber    String? // Their PO number if applicable

  // Relations for upstream party
  upstreamParty   Client?  @relation("UpstreamParty", fields: [upstreamPartyId], references: [id])
  upstreamContact Contact? @relation("Project_UpstreamContact", fields: [upstreamContactId], references: [id])

  // Existing financial/schedule fields retained
  budget      Decimal?  @db.Decimal(18, 2)
  actualSpend Decimal?  @db.Decimal(18, 2)
  startDate   DateTime?
  endDate     DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks          Task[]
  variations     Variation[]
  snapshot       ProjectSnapshot?
  memberships    ProjectMembership[]
  purchaseOrders PurchaseOrder[]

  budgetLines    BudgetLine[]
  commitments    Commitment[]
  actualCosts    ActualCost[]
  forecasts      Forecast[]
  financialItems FinancialItem[]
  packages       Package[]
  contracts      Contract[]
  awards         Award[]
  invoices       Invoice[]
  awardDecisions AwardDecision[]
  rfx            Rfx[]

  // Back-relation for ImportJob → Project
  importJobs ImportJob[]

  // Additive relations to new modules
  rfis                  Rfi[]
  qaRecords             QaRecord[]
  hsEvents              HsEvent[]
  carbonEntries         CarbonEntry[]
  ApplicationForPayment ApplicationForPayment[]
  paymentCertificates   PaymentCertificate[] // Task 3.1: Certificates received
  // MVP additive
  tenders               Tender[]
  // CVR tracking
  cvrCommitments        CVRCommitment[]
  cvrActuals            CVRActual[]
  cvrReports            CVRReport[]             @relation("ProjectCVRReports")

  // Additive relations for new info fields
  clientContact    Contact? @relation("Project_ClientContact", fields: [clientContactId], references: [id])
  // Disambiguate multiple relations to User
  projectManager   User?    @relation("Project_ProjectManager", fields: [projectManagerUserId], references: [id])
  quantitySurveyor User?    @relation("Project_QuantitySurveyor", fields: [quantitySurveyorUserId], references: [id])

  // APPROVAL FRAMEWORK RELATIONS
  projectRoles      ProjectRole[]      @relation("ProjectRoles")
  approvalWorkflows ApprovalWorkflow[] @relation("ProjectApprovalWorkflows")

  // Task 2.2: Upstream contract terms (when acting as subcontractor)
  upstreamContract UpstreamContract?

  // Task 3.4: Upstream retention tracking (retention held by MC from you)
  upstreamRetentionReleases UpstreamRetentionRelease[] @relation("UpstreamRetentionReleases")
  upstreamRetentionBonds    UpstreamRetentionBond[]    @relation("UpstreamRetentionBonds")

  // Task 4.2: Enhanced CVR cost tracking
  projectCosts    ProjectCost[]    @relation("ProjectCosts")
  cvrSnapshots    CVRSnapshot[]    @relation("ProjectCVRSnapshots")
  // CVR Phase B: Project forecast
  projectForecast ProjectForecast?

  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantId, projectRole]) // Task 2.1: Filter projects by role
  // Hot paths: client-filtered project lists and planned end sorting
  @@index([tenantId, clientId])
  @@index([tenantId, endPlanned])
  // Additive indexes for new info fields
  @@index([tenantId, clientContactId])
  @@index([tenantId, projectManagerUserId])
  @@index([tenantId, quantitySurveyorUserId])
}

// ==============================================================================
// UPSTREAM CONTRACT - CONTRACT TERMS WHEN ACTING AS SUBCONTRACTOR
// Task 2.2: Capture MC contract terms for automated retention & payment tracking
// ==============================================================================

model UpstreamContract {
  id        String @id @default(cuid())
  tenantId  String
  projectId Int    @unique // One upstream contract per project

  // Link to who gave you this contract
  mainContractorId Int? // FK to Client (where clientType includes MC)

  // Contract basics
  contractValue Decimal @db.Decimal(18, 2)
  contractType  String? // NEC4_OPTION_A, JCT_DB, etc.
  contractRef   String? // MC's contract reference
  poNumber      String? // MC's PO number
  description   String? @db.Text

  // Retention terms
  retentionPercentage Decimal  @default(0) @db.Decimal(5, 2)
  retentionCap        Decimal? @db.Decimal(18, 2)
  retentionCapAuto    Boolean  @default(true)
  retentionReleasePC  Decimal? @db.Decimal(5, 2) // % released at PC
  retentionReleaseDLP Decimal? @db.Decimal(5, 2) // % released at DLP end

  // Payment terms
  applicationDueDay  Int? // Day of month (1-31)
  applicationDueDays Int? // OR days after period end
  paymentTermsDays   Int  @default(30)
  payLessNoticeDays  Int? // Days before due date
  paymentNoticeDays  Int? // Days after application

  // Main Contractor Discount
  mainContractorDiscount Decimal @default(0) @db.Decimal(5, 2)
  mcdDescription         String?

  // CIS (does MC deduct CIS from you?)
  mcDeductsCIS Boolean @default(false)

  // Key dates
  startDate               DateTime?
  plannedCompletionDate   DateTime?
  actualCompletionDate    DateTime?
  practicalCompletionDate DateTime?
  dlpMonths               Int?
  dlpEndDate              DateTime?

  // Status
  status String @default("ACTIVE") // DRAFT, ACTIVE, COMPLETE, DISPUTED, TERMINATED

  // Documents
  contractDocumentUrl String?

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?
  updatedById Int?

  // Relations
  project        Project @relation(fields: [projectId], references: [id])
  mainContractor Client? @relation("UpstreamContractMainContractor", fields: [mainContractorId], references: [id])
  createdBy      User?   @relation("UpstreamContractCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?   @relation("UpstreamContractUpdatedBy", fields: [updatedById], references: [id])

  // Task 2.4: Applications raised against this upstream contract
  applications ApplicationForPayment[]

  // Task 3.1: Certificates received for this upstream contract
  certificates PaymentCertificate[]

  // Task 3.4: Retention releases and bonds
  retentionReleases UpstreamRetentionRelease[] @relation("UpstreamContractRetentionReleases")
  retentionBonds    UpstreamRetentionBond[]    @relation("UpstreamContractRetentionBonds")

  @@index([tenantId])
  @@index([tenantId, projectId])
  @@index([tenantId, mainContractorId])
  @@index([tenantId, status])
}

model CostCode {
  id          Int      @id @default(autoincrement())
  tenantId    String
  code        String
  description String?
  parentId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      CostCode?    @relation("CostCodeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    CostCode[]   @relation("CostCodeHierarchy")
  budgetLines BudgetLine[]
  packages    Package[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
}

model Task {
  id        Int     @id @default(autoincrement())
  projectId Int
  tenantId  String  @default("demo")
  project   Project @relation(fields: [projectId], references: [id])

  title       String
  description String?
  dueDate     DateTime?
  assignee    String?

  status String @default("Open")

  statusId  Int
  statusRel TaskStatus @relation("TaskStatusRel", fields: [statusId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, projectId])
  @@index([tenantId, projectId, status])
  @@index([projectId, dueDate])
  @@index([tenantId, title])
}

model Contact {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  tenantId String @default("demo")

  firstName String
  lastName  String?
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean @default(false)

  // Customer Portal Access
  portalEnabled Boolean   @default(false)
  passwordHash  String? // Hashed password for portal login
  portalToken   String? // Magic link token for passwordless login
  tokenExpiry   DateTime?
  lastLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relation to projects where this contact is the client contact
  projectsAsClientContact Project[] @relation("Project_ClientContact")

  // Task 2.1: Back-relation to projects where this contact is the upstream contact (MC or client)
  projectsAsUpstreamContact Project[] @relation("Project_UpstreamContact")

  // Task 2.4: Back-relation to applications where this contact is the recipient
  applicationsAsRecipient ApplicationForPayment[] @relation("ApplicationRecipientContact")

  // Customer portal sessions
  portalSessions CustomerPortalSession[]

  @@unique([clientId, email])
  @@index([tenantId, clientId])
  @@index([clientId, isPrimary])
  @@index([email])
  @@index([role])
  @@index([portalToken])
}

// Customer Portal Session Tracking
model CustomerPortalSession {
  id        String @id @default(uuid())
  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([token])
  @@index([expiresAt])
  @@map("customer_portal_sessions")
}

model Variation {
  id           Int       @id @default(autoincrement())
  projectId    Int
  tenantId     String
  project      Project   @relation(fields: [projectId], references: [id])
  packageId    Int?
  budgetLineId Int?
  contractId   Int?
  contract     Contract? @relation(fields: [contractId], references: [id])

  // Core identifiers
  reference       String? @db.VarChar(64)
  referenceCode   String? @db.VarChar(64) // legacy
  variationNumber String? @db.VarChar(50) // VO-001, VO-002, etc.
  title           String  @db.VarChar(255)
  description     String? @db.Text
  contractType    String  @db.VarChar(24)

  // Initiation details
  siteInstructionRef String?   @db.VarChar(100)
  instructedBy       Int? // User ID
  instructionDate    DateTime?
  originatedFrom     String?   @db.VarChar(50) // Client, Architect, Engineer, etc.
  urgency            String    @default("standard") @db.VarChar(20) // standard, urgent, critical
  category           String?   @db.VarChar(50) // Addition, Omission, Substitution, Daywork

  // Strings (avoid Prisma enums)
  type        String  @db.VarChar(24)
  status      String  @db.VarChar(24)
  reason      String? @db.VarChar(255)
  reason_code String? @db.VarChar(64) // legacy

  // Commercials
  // New spec fields
  amount         Decimal @default(0) @db.Decimal(18, 2)
  value          Decimal @db.Decimal(18, 2)
  costImpact     Decimal @db.Decimal(18, 2)
  timeImpactDays Int?
  notes          String?
  justification  String?

  // Detailed financial breakdown (UK construction practice)
  estimatedValue  Decimal? @db.Decimal(18, 2) // Initial estimate
  quotedValue     Decimal? @db.Decimal(18, 2) // Contractor's quote
  negotiatedValue Decimal? @db.Decimal(18, 2) // After negotiation
  approvedValue   Decimal? @db.Decimal(18, 2) // Final approved
  certifiedValue  Decimal? @db.Decimal(18, 2) // Certified for payment
  dayworkValue    Decimal? @db.Decimal(18, 2) // Daywork portion
  breakdown       Json? // Array of cost items

  // Legacy/computed fields retained for compatibility
  estimated_cost Decimal? @db.Decimal(18, 2)
  estimated_sell Decimal? @db.Decimal(18, 2)
  agreed_cost    Decimal? @db.Decimal(18, 2)
  agreed_sell    Decimal? @db.Decimal(18, 2)

  // Time & Programme Impact
  extensionClaimed   Int? // EOT claimed (days)
  extensionGranted   Int? // EOT granted (days)
  timeJustification  String? @db.Text
  affectedActivities Json? // Array of affected activities/packages

  // Workflow & Approvals
  approvals          Json? // Array of approval records
  implementationDate DateTime?
  completionDate     DateTime?

  // Related Items
  relatedVariationIds Int[] // Related/superseded variations
  affectedPackageIds  Int[] // Packages affected by this variation

  // Dates
  notifiedDate   DateTime?
  submittedDate  DateTime?
  submissionDate DateTime?
  decisionDate   DateTime?
  reviewedDate   DateTime?
  approvedDate   DateTime?
  approvedAt     DateTime?
  rejectedDate   DateTime?
  instructedDate DateTime?
  pricedDate     DateTime?
  agreedDate     DateTime?
  voIssuedDate   DateTime?
  voAcceptedDate DateTime?
  approvedBy     Int?

  // Meta
  is_deleted Boolean  @default(false)
  createdBy  Int? // User who created this variation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  lines           VariationLine[]
  statusHistory   VariationStatusHistory[]
  documents       VariationDocument[]
  comments        VariationComment[]
  approvalRecords VariationApproval[]

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([reference])
  @@index([referenceCode])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
  @@index([tenantId, projectId, status])
  @@index([tenantId, projectId, status, updatedAt])
  @@index([tenantId, contractId])
  @@index([tenantId, budgetLineId])
  @@index([tenantId, packageId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([tenantId, title])
  @@index([tenantId, reference])
  @@index([variationNumber])
  @@index([urgency])
  @@index([tenantId, contractId, variationNumber])
}

model VariationDocument {
  id          Int       @id @default(autoincrement())
  tenantId    String
  variationId Int
  variation   Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  type     String // Site Instruction, Quotation, Drawing, Photo, etc.
  title    String
  fileId   String // Reference to file storage
  fileName String
  fileSize Int
  mimeType String

  uploadedBy Int?
  uploadedAt DateTime @default(now())

  @@index([variationId])
  @@index([tenantId])
}

model VariationComment {
  id          Int       @id @default(autoincrement())
  tenantId    String
  variationId Int
  variation   Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  content  String  @db.Text
  internal Boolean @default(true) // Internal vs shared with contractor

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variationId])
  @@index([tenantId])
  @@index([createdAt])
}

model VariationApproval {
  id          Int       @id @default(autoincrement())
  tenantId    String
  variationId Int
  variation   Variation @relation(fields: [variationId], references: [id], onDelete: Cascade)

  approverUserId Int?
  approverRole   String // Project Manager, Cost Manager, Client Representative, etc.
  sequenceOrder  Int     @default(1)
  status         String  @default("pending") // pending, approved, rejected
  decision       String? // approved, rejected, conditional
  comments       String? @db.Text
  conditions     Json? // Array of conditions if conditional approval

  requestedAt DateTime  @default(now())
  respondedAt DateTime?

  @@index([variationId])
  @@index([status])
  @@index([approverUserId])
  @@index([tenantId])
}

model VariationLine {
  id          Int       @id @default(autoincrement())
  variationId Int
  variation   Variation @relation(fields: [variationId], references: [id])
  tenantId    String

  cost_code   String?  @db.VarChar(64) // legacy
  description String   @db.VarChar(255)
  qty         Decimal  @db.Decimal(18, 3)
  rate        Decimal  @db.Decimal(18, 2)
  value       Decimal  @db.Decimal(18, 2)
  sort        Int      @default(0)
  unit        String?  @db.VarChar(32) // legacy
  unit_cost   Decimal? @db.Decimal(18, 2) // legacy
  unit_sell   Decimal? @db.Decimal(18, 2) // legacy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variationId])
  @@index([tenantId])
}

model VariationStatusHistory {
  id          Int       @id @default(autoincrement())
  variationId Int
  variation   Variation @relation(fields: [variationId], references: [id])
  tenantId    String

  fromStatus String?  @db.VarChar(24)
  toStatus   String   @db.VarChar(24)
  changedBy  Int? // User ID who made the change
  note       String?  @db.VarChar(255)
  changedAt  DateTime @default(now())

  @@index([variationId])
  @@index([tenantId, variationId, changedAt])
}

model ProjectSnapshot {
  projectId Int    @id
  tenantId  String

  // Financial
  budget             Decimal? @db.Decimal(18, 2)
  committed          Decimal? @db.Decimal(18, 2)
  actual             Decimal? @db.Decimal(18, 2)
  retentionHeld      Decimal? @db.Decimal(18, 2)
  forecastAtComplete Decimal? @db.Decimal(18, 2)
  variance           Decimal? @db.Decimal(18, 2)

  financialBudget    Decimal @default(0)
  financialCommitted Decimal @default(0)
  financialActual    Decimal @default(0)
  financialForecast  Decimal @default(0)

  // Schedule
  schedulePct    Int?
  criticalAtRisk Int?

  // Variations
  variationsDraft         Int?
  variationsSubmitted     Int?
  variationsApproved      Int?
  variationsValueApproved Decimal? @db.Decimal(18, 2)

  // Tasks
  tasksOverdue     Int?
  tasksDueThisWeek Int?

  // RFIs (placeholder counts until RFI module lands)
  rfisOpen       Int?
  rfisAvgAgeDays Int?

  // QA/QC
  qaOpenNCR   Int?
  qaOpenPunch Int?

  // H&S
  hsIncidentsThisMonth Int?
  hsOpenPermits        Int?

  // Procurement
  procurementCriticalLate Int?
  procurementPOsOpen      Int?

  // Carbon
  carbonTarget Decimal? @db.Decimal(18, 2)
  carbonToDate Decimal? @db.Decimal(18, 2)
  carbonUnit   String?

  updatedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id           BigInt         @id @default(autoincrement())
  tenantId     String
  filename     String
  mimeType     String
  size         Int
  storageKey   String         @unique
  sha256       String?
  uploadedAt   DateTime       @default(now())
  uploadedById String?
  links        DocumentLink[]

