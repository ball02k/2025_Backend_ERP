// Supplier Management
model Supplier {
  id                      Int       @id @default(autoincrement())
  tenantId                String
  name                    String
  status                  String    @default("active")
  // Contact details (additive)
  email                   String?
  phone                   String?
  companyRegNo            String?
  vatNo                   String?
  // Insurance details (additive)
  insurancePolicyNumber   String?
  insuranceExpiry         DateTime?
  hsAccreditations        String?
  performanceScore        Decimal?
  complianceStatus        String?
  // CIS (Construction Industry Scheme) details (additive)
  cisRegistered           Boolean?  @default(false)
  cisVerificationStatus   String? // GROSS | NET | UNVERIFIED
  cisVerificationDate     DateTime?
  cisVerificationExpiry   DateTime?
  utr                     String? // Unique Taxpayer Reference (10 digits)
  companyUtr              String? // Company UTR for limited companies
  niNumber                String? // National Insurance Number (UK format: AB123456C)
  cisNotes                String?
  defaultLabourPercentage Decimal?  @default(100) // Default labour % for CIS calculation (0-100)

  // VAT (Value Added Tax) - Task 1.5
  vatRegistered Boolean? @default(false) // Is supplier VAT registered?
  vatNumber     String? // UK VAT number (GB format: GB123456789 or GB123456789012)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capabilities          SupplierCapability[]
  prequalification      SupplierPrequalification?
  invites               TenderInvite[]            @relation("SupplierInvites")
  submissions           Submission[]              @relation("SupplierSubmissions")
  // Additive relations for tendering module
  tenderInvites         TenderSupplierInvite[]
  tenderResponses       TenderResponse[]
  tenderSubmissions     TenderSubmission[]        @relation("TenderSubmissionSupplier")
  contracts             Contract[]
  awards                Award[]
  awardDecisions        AwardDecision[]
  complianceOverrides   ComplianceOverride[]
  awardedPackages       Package[]                 @relation("PackageAwardSupplier")
  awardedToPackages     Package[]                 @relation("PackageAwardedToSupplier")
  invoices              Invoice[]
  onboardingTokens      SupplierOnboardingToken[]
  ApplicationForPayment ApplicationForPayment[]
  packageResponses      PackageResponse[]
  tenderInvitations     TenderInvitation[]        @relation("TenderInvitationSupplier")

  @@index([tenantId, name])
  @@index([tenantId, status])
}

