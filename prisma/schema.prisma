  tenantId    String
  scorecardId Int
  category    String
  kpi         String
  weight      Decimal
  value       Decimal?
  comment     String?
}

// ==========================================
// BUDGET CATEGORY TAGGING SYSTEM
// ==========================================

model BudgetCategory {
  id       String @id @default(cuid())
  tenantId String

  // Category details
  code        String // PREL, SUBS, SUPS, etc.
  name        String // "Preliminaries", "Substructure"
  description String? @db.Text

  // Display
  color     String @default("#64748b") // Hex color for badge
  sortOrder Int    @default(0)

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // System-provided

  // Audit
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  budgetLines BudgetLine[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model BudgetLine {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default("demo")
  projectId   Int
  code        String?
  periodMonth String?
  description String?
  qty         Decimal  @default(0) @db.Decimal(18, 2)
  unit        String?
  rate        Decimal  @default(0) @db.Decimal(18, 4)
  total       Decimal  @default(0) @db.Decimal(18, 2)
  amount      Decimal  @default(0)
  planned     Decimal? @db.Decimal(18, 2)
  estimated   Decimal? @db.Decimal(18, 2)
  actual      Decimal? @db.Decimal(18, 2)

  // Forecast/Anticipated Final tracking (British English: "Forecast" not "Anticipated")
  forecastFinalCost   Decimal?  @db.Decimal(18, 2)
  forecastVariance    Decimal?  @db.Decimal(18, 2)
  lastForecastUpdated DateTime?
  forecastNotes       String?   @db.Text

  // CVR Phase B: Enhanced Forecasting
  forecastMethod          ForecastMethod? @default(COMMITTED)
  forecastAdjustment      Decimal         @default(0) @db.Decimal(18, 2)
  forecastAdjustmentNotes String?         @db.Text
  anticipatedVariations   Decimal         @default(0) @db.Decimal(18, 2)
  riskAllowance           Decimal         @default(0) @db.Decimal(18, 2)
  forecastUpdatedBy       String?
  forecastStatus          ForecastStatus? @default(ON_TRACK)
  costToComplete          Decimal?        @db.Decimal(18, 2)

  // Task 2.3: Budget Import fields for Subcontractor Mode
  source              String? @default("INTERNAL") // INTERNAL, IMPORTED_MC, IMPORTED_CLIENT
  externalRef         String? // MC's reference for this line
  originalDescription String? @db.Text // MC's original description (preserved)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  costCodeId Int?
  categoryId String? // NEW: Category tagging
  // Grouping (additive)
  groupId    Int?
  sortOrder  Int?     @default(0)
  position   Int      @default(0)

  project                 Project                      @relation(fields: [projectId], references: [id])
  costCode                CostCode?                    @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  budgetCategory          BudgetCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group                   BudgetGroup?                 @relation(fields: [groupId], references: [id])
  // Link budget lines to procurement packages
  packageItems            PackageItem[]
  contractLines           ContractLineItem[]           @relation("BudgetLineContractLines")
  // CVR tracking
  cvrCommitments          CVRCommitment[]
  cvrActuals              CVRActual[]
  contractValuations      ContractValuation[]          @relation("BudgetLineValuations")
  purchaseOrders          PurchaseOrder[]
  invoices                Invoice[]
  invoiceLines            InvoiceLine[]
  // Category allocations
  allocations             BudgetLineAllocation[]
  // Task 2.5: Link to outbound payment application lines
  paymentApplicationLines PaymentApplicationLineItem[]
  // Task 4.2: Direct cost entries
  projectCosts            ProjectCost[]                @relation("BudgetLineCosts")
  // CVR Phase B: Forecast history tracking
  forecastHistory         BudgetLineForecastHistory[]

  @@index([tenantId, projectId])
  @@index([tenantId, projectId, periodMonth])
  @@index([tenantId, costCodeId])
  @@index([tenantId, categoryId])
  @@index([tenantId, groupId])
}

// Budget line grouping (system/user groups)
model BudgetGroup {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default("demo")
  projectId Int
  name      String
  sortOrder Int      @default(0)
  position  Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opposite relation for BudgetLine.group
  budgetLines BudgetLine[]

  @@index([tenantId, projectId])
}

// Task 2.3: Import Mapping - Save column mappings for budget import reuse
model ImportMapping {
