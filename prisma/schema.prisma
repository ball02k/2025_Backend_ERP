}

// ============================================
// CVR (COST VALUE RECONCILIATION) SYSTEM
// ============================================

/// CVRCommitment - Links budget lines to financial commitments
/// Tracks: Contract awards, Variation approvals, PO issues
/// Purpose: Know what we've committed to spend against each budget line
model CVRCommitment {
  id       Int    @id @default(autoincrement())
  tenantId String

  // Link to budget
  projectId    Int
  project      Project     @relation(fields: [projectId], references: [id])
  budgetLineId Int?
  budgetLine   BudgetLine? @relation(fields: [budgetLineId], references: [id])

  // Link to category allocation (optional)
  allocationId String?
  allocation   BudgetLineAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  // Source of commitment
  sourceType String // "CONTRACT" | "VARIATION" | "PURCHASE_ORDER"
  sourceId   Int // contractId, variationId, or poId

  // Financial
  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("GBP")
  status   String // "PENDING" | "COMMITTED" | "SUPERSEDED" | "CANCELLED"

  // Metadata
  description String?
  reference   String? // Contract ref, variation number, PO code
  costCode    String?

  // Dates
  commitmentDate DateTime  @default(now())
  effectiveDate  DateTime? // When commitment takes effect
  cancelledDate  DateTime?

  // Audit
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, projectId])
  @@index([tenantId, budgetLineId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, projectId, status])
  @@index([tenantId, costCode])
  @@index([allocationId])
  @@map("cvr_commitments")
}

/// CVRActual - Links budget lines to actual costs incurred
/// Tracks: Invoice receipts, Payment applications, Actual payments
/// Purpose: Know what we've actually spent against each budget line
model CVRActual {
  id       Int    @id @default(autoincrement())
  tenantId String

  // Link to budget
  projectId    Int
  project      Project     @relation(fields: [projectId], references: [id])
  budgetLineId Int?
  budgetLine   BudgetLine? @relation(fields: [budgetLineId], references: [id])

  // Link to category allocation (optional)
  allocationId String?
  allocation   BudgetLineAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)

  // Source of actual cost
  sourceType String // "INVOICE" | "PAYMENT_APPLICATION" | "DIRECT_COST"
  sourceId   Int // invoiceId, applicationId, or other ID

  // Financial
  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("GBP")
  status   String // "RECORDED" | "CERTIFIED" | "PAID" | "REVERSED"

  // Metadata
  description String?
  reference   String? // Invoice number, APP number
  costCode    String?

  // Dates
  incurredDate  DateTime  @default(now())
  certifiedDate DateTime?
  paidDate      DateTime?

  // Audit
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, projectId])
  @@index([tenantId, budgetLineId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, projectId, status])
  @@index([tenantId, costCode])
  @@index([tenantId, incurredDate])
  @@index([allocationId])
  @@map("cvr_actuals")
}

// ==============================================================================
// CONTRACT VALUATION - Revenue/Value Tracking (British English)
// ==============================================================================

model ContractValuation {
  id       Int    @id @default(autoincrement())
  tenantId String

  // Link to contract
  contractId Int
  contract   Contract @relation("ContractValuations", fields: [contractId], references: [id])

  // Link to budget (optional)
  budgetLineId Int?
  budgetLine   BudgetLine? @relation("BudgetLineValuations", fields: [budgetLineId], references: [id])

  // Valuation details
  valuationNumber Int
  valuationDate   DateTime

  // Amounts (British English: "Gross" not "Total")
  grossValuation   Decimal @db.Decimal(18, 2)
  retention        Decimal @db.Decimal(18, 2)
  netValuation     Decimal @db.Decimal(18, 2)
  previouslyValued Decimal @db.Decimal(18, 2)
  thisValuation    Decimal @db.Decimal(18, 2)

  // Materials on site (if applicable)
  materialsOnSite Decimal? @db.Decimal(18, 2)

  // Status
  status String @default("DRAFT") // DRAFT, SUBMITTED, CERTIFIED, INVOICED

  // Dates
  certifiedDate DateTime?
  invoicedDate  DateTime?
  paidDate      DateTime?

  // Notes (British English: "Notes" not "Comments")
  notes String? @db.Text

  // Audit
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, contractId])
  @@index([tenantId, budgetLineId])
  @@index([tenantId, valuationDate])
  @@index([tenantId, status])
  @@map("contract_valuations")
}

// ==============================================================================
// CVR REPORT - Period Reporting with Approval Workflow (British English)
// ==============================================================================

model CVRReport {
  id       String @id @default(cuid())
  tenantId String

  // Link to project
  projectId Int
  project   Project @relation("ProjectCVRReports", fields: [projectId], references: [id])

  // Report details
  reportDate DateTime
  periodEnd  DateTime
  reportType String // MONTHLY, QUARTERLY, YEAR_END, AD_HOC

  // Status (British English workflow)
  status String @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, APPROVED, REJECTED

  // Snapshot data (stored as JSON for flexibility)
  snapshotData Json

  // Notes (British English: "Comments" as a field name, but "Notes" in UI)
  comments String? @db.Text

  // Approval workflow
  submittedBy Int?
  submittedAt DateTime?

  approvedBy Int?
  approvedAt DateTime?

  rejectedBy      Int?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  // Export paths (British English: "Exported" not "Generated")
  exportedPdf   String? // Path to PDF
  exportedExcel String? // Path to Excel
  is_deleted    Boolean @default(false)

  // Audit
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, projectId])
  @@index([tenantId, reportDate])
  @@index([tenantId, status])
  @@index([tenantId, periodEnd])
  @@map("cvr_reports")
}

// ==============================================================================
// ALLOCATION CATEGORIES & BUDGET LINE ALLOCATIONS
// ==============================================================================

/// AllocationCategory - Defines standard construction categories for budget splitting
/// Used to split budget lines into categories like Prelims, Substructure, etc.
model AllocationCategory {
  id       String @id @default(cuid())
  tenantId String

  // Category details
  code        String // PREL, SUBS, SUPS, EXTW, etc.
  name        String // "Preliminaries", "Substructure", etc.
  description String? @db.Text

  // Hierarchy (for nested categories)
  parentId String?
  parent   AllocationCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AllocationCategory[] @relation("CategoryHierarchy")

  // Display order
  sortOrder Int @default(0)

  // Status
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // System-provided categories

  // Audit
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  allocations BudgetLineAllocation[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([parentId])
  @@map("allocation_categories")
}

/// BudgetLineAllocation - Splits a budget line into category allocations
/// Example: £500k budget line → £50k Prelims + £150k Substructure + ...
model BudgetLineAllocation {
  id       String @id @default(cuid())
  tenantId String

  // Parent budget line
  budgetLineId Int
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)

  // Category
  categoryId String
  category   AllocationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Financial
  allocatedAmount Decimal @db.Decimal(12, 2)
  currency        String  @default("GBP")

  // Status
  status String @default("ACTIVE") // ACTIVE, TRANSFERRED, CANCELLED

  // Notes
  notes String? @db.Text

  // Audit
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cvrCommitments CVRCommitment[]
  cvrActuals     CVRActual[]
  transfersFrom  BudgetTransfer[] @relation("TransferFrom")
  transfersTo    BudgetTransfer[] @relation("TransferTo")

  @@unique([budgetLineId, categoryId, tenantId])
  @@index([tenantId, budgetLineId])
  @@index([categoryId])
  @@index([status])
  @@map("budget_line_allocations")
}

/// BudgetTransfer - Tracks budget transfers between category allocations
/// Used for moving budget between categories with audit trail
model BudgetTransfer {
  id       String @id @default(cuid())
  tenantId String

  // Transfer details
  fromAllocationId String
  fromAllocation   BudgetLineAllocation @relation("TransferFrom", fields: [fromAllocationId], references: [id], onDelete: Restrict)

  toAllocationId String
  toAllocation   BudgetLineAllocation @relation("TransferTo", fields: [toAllocationId], references: [id], onDelete: Restrict)

  // Amount
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("GBP")

  // Justification
  reason String @db.Text

  // Approval
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?   @db.Text

  // Audit
  requestedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, fromAllocationId])
  @@index([tenantId, toAllocationId])
  @@index([status])
  @@map("budget_transfers")
}

// ==============================================================================
// Upstream Retention Register (Task 3.4)
// Track retention held by Main Contractor (INBOUND retention)
// ==============================================================================

/// UpstreamRetentionRelease - Track retention releases from MC at PC, DLP, or early releases
model UpstreamRetentionRelease {
  id                 String @id @default(cuid())
  tenantId           String
  projectId          Int
  upstreamContractId String

  // Release type
  releaseType String // PC_RELEASE, DLP_RELEASE, EARLY_RELEASE, BOND_SUBSTITUTION

  // Amounts
  releaseAmount   Decimal @db.Decimal(15, 2)
  retentionBefore Decimal @db.Decimal(15, 2) // Total held before this release
  retentionAfter  Decimal @db.Decimal(15, 2) // Total held after this release

  // Release details
  releaseDate   DateTime? // When actually released
  requestedDate DateTime? // When we requested it
  expectedDate  DateTime? // When we expect it (from contract terms)

  // For claims
  claimStatus      String    @default("NOT_CLAIMED") // NOT_CLAIMED, CLAIMED, APPROVED, PAID, DISPUTED
  claimReference   String?
  claimSubmittedAt DateTime?

  // Payment tracking (when released)
  paymentReceivedDate DateTime?
  paymentAmount       Decimal?  @db.Decimal(15, 2)
  paymentReference    String?

  // Supporting info
  notes       String? @db.Text
  documentUrl String? // PC cert, DLP completion, etc.

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?

  // Relations
  project          Project          @relation("UpstreamRetentionReleases", fields: [projectId], references: [id])
  upstreamContract UpstreamContract @relation("UpstreamContractRetentionReleases", fields: [upstreamContractId], references: [id])
  createdBy        User?            @relation("UpstreamRetentionReleaseCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([upstreamContractId])
  @@index([claimStatus])
  @@index([releaseType])
}

/// UpstreamRetentionBond - Track retention bonds with MC substituted for cash retention
model UpstreamRetentionBond {
  id                 String @id @default(cuid())
  tenantId           String
  projectId          Int
  upstreamContractId String

  // Bond details
  bondProvider  String // Insurance company / bank
  bondReference String
  bondAmount    Decimal @db.Decimal(15, 2)
  bondType      String // ON_DEMAND, CONDITIONAL

  // Dates
  issueDate  DateTime
  expiryDate DateTime

  // Status
  status String @default("ACTIVE") // ACTIVE, EXPIRED, CALLED, RETURNED

  // Document
  bondDocumentUrl String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project          Project          @relation("UpstreamRetentionBonds", fields: [projectId], references: [id])
  upstreamContract UpstreamContract @relation("UpstreamContractRetentionBonds", fields: [upstreamContractId], references: [id])

  @@index([tenantId])
  @@index([projectId])
  @@index([upstreamContractId])
  @@index([status])
}

// ==============================================================================
// Task 4.2: CVR Cost Tracking Enhancements
// Enhanced cost tracking with direct cost entries and historical snapshots
// ==============================================================================

/// ProjectCost - Direct cost entries not from POs or invoices
/// Used for recording costs like labour, direct expenses, accruals, etc.
model ProjectCost {
  id       Int    @id @default(autoincrement())
  tenantId String

  // Links
  projectId    Int
  project      Project     @relation("ProjectCosts", fields: [projectId], references: [id], onDelete: Cascade)
  budgetLineId Int?
  budgetLine   BudgetLine? @relation("BudgetLineCosts", fields: [budgetLineId], references: [id], onDelete: SetNull)

  // Cost classification
  costCategory String // LABOUR, MATERIALS, SUBCONTRACTOR, PLANT, PRELIMINARIES, OVERHEAD, OTHER
  costType     String // DIRECT, INDIRECT, OVERHEAD
  costStatus   String // COMMITTED, ACCRUED, INVOICED, PAID

  // Financial
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("GBP")
  vatAmount   Decimal? @db.Decimal(18, 2)
  totalAmount Decimal? @db.Decimal(18, 2) // amount + vat

  // Description
  description String  @db.Text
  reference   String? // Internal reference
  costCode    String? // Cost code for categorization
  notes       String? @db.Text

  // Source tracking
  sourceType      String? // TIMESHEET, DIRECT_ENTRY, ACCRUAL, JOURNAL
  sourceReference String? // Timesheet ID, journal number, etc.

  // Dates
  incurredDate  DateTime  @default(now()) // When cost was incurred
  committedDate DateTime? // When committed (if applicable)
  invoicedDate  DateTime? // When invoiced (if applicable)
  paidDate      DateTime? // When paid (if applicable)
  periodMonth   String? // YYYY-MM for period allocation

  // Supplier/vendor (optional)
  supplierName String?
  supplierId   Int?

  // Approval workflow
  approvalStatus String    @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  approvedBy     Int?
  approvedAt     DateTime?
  rejectedReason String?   @db.Text

  // Audit
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, projectId])
  @@index([tenantId, budgetLineId])
  @@index([projectId, costCategory])
  @@index([projectId, costStatus])
  @@index([projectId, periodMonth])
  @@index([incurredDate])
  @@index([costCategory, costStatus])
  @@map("project_costs")
}

// ============================================================================
// EXPORT LAYER - Task 5.1
// ============================================================================

enum ExportFormat {
  XLSX
  PDF
  CSV
  DOCX
  JSON
  XML
}

enum ExportCategory {
  PAYMENT_APPLICATION
  PAYMENT_CERTIFICATE
  VALUATION
  INVOICE
  CVR_REPORT
  RETENTION_STATEMENT
  AGED_RECEIVABLES
}

enum TemplateScope {
  SYSTEM // Built-in templates
  TENANT // Organisation-specific
  PROJECT // Project-specific
}

model ExportTemplate {
  id       String  @id @default(cuid())
  tenantId String? // Null for system templates

  // Identification
  name        String
  code        String // Unique code e.g., "BALFOUR_APP_V1"
  description String? @db.Text

  // Classification
  category ExportCategory
  format   ExportFormat
  scope    TemplateScope  @default(TENANT)

  // Template configuration
  config        Json // Template-specific configuration
  fieldMappings Json // Maps internal fields to template fields

  // For file-based templates (Excel, Word)
  templateFileUrl String? // URL to template file in storage
  templateVersion String? // Version of template file

  // Metadata
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // Default for this category
  sortOrder Int     @default(0)

  // MC/Client association (optional)
  mainContractorId   String? // If template is for specific MC
  mainContractorName String? // e.g., "Balfour Beatty"

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  exports ExportLog[]

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@index([category, format])
}

model ExportLog {
  id       String @id @default(cuid())
  tenantId String

  // What was exported
  category  ExportCategory
  sourceId  String // ID of the exported record
  sourceRef String? // Human-readable reference

  // How it was exported
  templateId String?
  format     ExportFormat

  // Result
  fileUrl  String? // URL to generated file
  fileName String
  fileSize Int?

  // Status
  status       String  @default("COMPLETED") // PENDING, COMPLETED, FAILED
  errorMessage String? @db.Text

  // Audit
  exportedAt DateTime @default(now())
  exportedBy String

  // Relations
  template ExportTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId, category])
  @@index([tenantId, sourceId])
  @@index([exportedAt])
}

// ==============================================================================
// CVR PHASE B: FORECAST & ANTICIPATED FINAL COST
// ==============================================================================

// Track changes to forecasts over time (audit trail)
model BudgetLineForecastHistory {
  id           String @id @default(cuid())
  tenantId     String
  budgetLineId Int

  // Snapshot of values at this point
  previousForecast Decimal @db.Decimal(18, 2)
  newForecast      Decimal @db.Decimal(18, 2)
  changeAmount     Decimal @db.Decimal(18, 2)
  changeReason     String? @db.Text

  // What triggered the change
  changeType ForecastChangeType

  // Context
  committed Decimal @db.Decimal(18, 2) // Committed at time of change
  actual    Decimal @db.Decimal(18, 2) // Actual at time of change

  // Audit
  createdAt DateTime @default(now())
  createdBy String

  // Relations
  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id])

  @@index([budgetLineId])
  @@index([tenantId, createdAt])
}

// Project-level forecast tracking
model ProjectForecast {
  id        String @id @default(cuid())
  tenantId  String
  projectId Int    @unique // One active forecast per project

  // Totals (calculated from budget lines)
  totalBudget           Decimal @db.Decimal(18, 2)
  totalCommitted        Decimal @db.Decimal(18, 2)
  totalActual           Decimal @db.Decimal(18, 2)
  totalAnticipatedFinal Decimal @db.Decimal(18, 2)

  // Variances
  budgetVariance     Decimal @db.Decimal(18, 2) // Budget - Anticipated
  commitmentVariance Decimal @db.Decimal(18, 2) // Committed - Anticipated

  // Cost to complete
  costToComplete Decimal @db.Decimal(18, 2) // Anticipated - Actual

  // Risk & contingency
  totalRiskAllowance   Decimal @db.Decimal(18, 2)
  contingencyRemaining Decimal @db.Decimal(18, 2)

  // Status
  overallStatus ForecastStatus

  // Last update
  lastCalculatedAt DateTime  @default(now())
  lastReviewedAt   DateTime?
  lastReviewedBy   String?

  // Relations
  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId])
}

// ==============================================================================
// INVENTORY MANAGEMENT & PURCHASE ORDERS
